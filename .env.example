PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=password
DB_NAME=data_selling_app
DB_PORT=3306

# JWT
JWT_SECRET=your_jwt_secret_key_here
